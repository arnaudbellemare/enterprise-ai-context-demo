'use client';

import { useState, useCallback, useRef } from 'react';
import DOMPurify from 'isomorphic-dompurify';
import { GlassCard } from '@/components/ui/GlassCard';
import { GradientButton } from '@/components/ui/GradientButton';
import { FloatingLabel } from '@/components/ui/FloatingLabel';
import { EmailHistoryDashboard } from '@/components/email/EmailHistoryDashboard';
import {
  EMAIL_RESPONDER_CONFIG,
  ERROR_MESSAGES,
  SUCCESS_MESSAGES,
  validators,
  emailExtractors,
} from '@/config/email-responder';
import '../../styles/email-responder.css';

interface ClassificationResult {
  classification: {
    template: {
      id: string;
      name: string;
      priority: number;
      description: string;
    };
    confidence: number;
    reasoning: string;
    extractedEntities: {
      dates?: string[];
      amounts?: string[];
      locations?: string[];
      people?: string[];
      documents?: string[];
      phoneNumbers?: string[];
    };
  };
  generatedResponse: {
    subject: string;
    body: string;
    to: string;
    from: string;
    language: string;
  };
}

export default function EmailResponderPage() {
  const [emailText, setEmailText] = useState('');
  const [fromEmail, setFromEmail] = useState('');
  const [subject, setSubject] = useState('');
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState<ClassificationResult | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [usePalimpzest, setUsePalimpzest] = useState<boolean>(EMAIL_RESPONDER_CONFIG.ENABLE_PALIMPZEST_BY_DEFAULT);
  const [copySuccess, setCopySuccess] = useState<string | null>(null);
  const [activeTab, setActiveTab] = useState<'compose' | 'history'>('compose');

  // Debouncing state
  const [isDebouncing, setIsDebouncing] = useState(false);
  const debounceTimerRef = useRef<NodeJS.Timeout | null>(null);

  /**
   * Validate email input before processing
   */
  const validateInput = useCallback((): string | null => {
    const trimmedEmail = emailText.trim();

    if (!trimmedEmail) {
      return ERROR_MESSAGES.EMPTY_EMAIL;
    }

    if (validators.isTooShort(trimmedEmail)) {
      return ERROR_MESSAGES.EMAIL_TOO_SHORT;
    }

    if (validators.isTooLong(trimmedEmail)) {
      return ERROR_MESSAGES.EMAIL_TOO_LONG;
    }

    if (fromEmail && !validators.isValidEmail(fromEmail)) {
      return ERROR_MESSAGES.INVALID_EMAIL_FORMAT;
    }

    return null;
  }, [emailText, fromEmail]);

  /**
   * Sanitize email input to prevent XSS
   */
  const sanitizeInput = useCallback((text: string): string => {
    return DOMPurify.sanitize(text, {
      ALLOWED_TAGS: [],
      KEEP_CONTENT: true,
    });
  }, []);

  /**
   * Handle form submission with debouncing and security
   */
  const handlePaste = useCallback(async () => {
    if (isDebouncing) {
      return;
    }

    const validationError = validateInput();
    if (validationError) {
      setError(validationError);
      return;
    }

    setIsDebouncing(true);
    if (debounceTimerRef.current) {
      clearTimeout(debounceTimerRef.current);
    }

    setLoading(true);
    setError(null);
    setResult(null);

    try {
      const sanitizedEmail = sanitizeInput(emailText);

      let extractedFrom = fromEmail;
      let extractedSubject = subject;

      if (!extractedFrom) {
        extractedFrom = emailExtractors.extractFrom(sanitizedEmail) || 'unknown@example.com';
      }

      if (!extractedSubject) {
        extractedSubject = emailExtractors.extractSubject(sanitizedEmail) || 'No Subject';
      }

      const controller = new AbortController();
      const timeoutId = setTimeout(
        () => controller.abort(),
        EMAIL_RESPONDER_CONFIG.REQUEST_TIMEOUT_MS
      );

      const response = await fetch(
        `${EMAIL_RESPONDER_CONFIG.API_ENDPOINT}?palimpzest=${usePalimpzest}`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            from: extractedFrom,
            to: EMAIL_RESPONDER_CONFIG.DEFAULT_TO_EMAIL,
            subject: extractedSubject,
            body: sanitizedEmail,
          }),
          signal: controller.signal,
        }
      );

      clearTimeout(timeoutId);

      if (!response.ok) {
        if (response.status === 429) {
          throw new Error(ERROR_MESSAGES.RATE_LIMITED);
        }

        let errorData;
        try {
          errorData = await response.json();
        } catch (jsonError) {
          throw new Error(ERROR_MESSAGES.SERVER_ERROR(response.status));
        }
        throw new Error(errorData.error || errorData.message || ERROR_MESSAGES.SERVER_ERROR(response.status));
      }

      const data = await response.json();
      setResult(data);
    } catch (err: any) {
      console.error('Error processing email:', err);

      if (err.name === 'AbortError') {
        setError(ERROR_MESSAGES.TIMEOUT_ERROR);
      } else if (err.message.includes('fetch')) {
        setError(ERROR_MESSAGES.NETWORK_ERROR);
      } else {
        setError(err.message || ERROR_MESSAGES.GENERIC_ERROR);
      }
    } finally {
      setLoading(false);

      debounceTimerRef.current = setTimeout(() => {
        setIsDebouncing(false);
      }, EMAIL_RESPONDER_CONFIG.DEBOUNCE_DELAY_MS);
    }
  }, [emailText, fromEmail, subject, usePalimpzest, isDebouncing, validateInput, sanitizeInput]);

  /**
   * Copy response to clipboard
   */
  const copyToClipboard = useCallback(async (text: string, type: 'full' | 'body') => {
    try {
      await navigator.clipboard.writeText(text);
      setCopySuccess(type === 'full' ? SUCCESS_MESSAGES.RESPONSE_COPIED : SUCCESS_MESSAGES.BODY_COPIED);
      setTimeout(() => setCopySuccess(null), 2000);
    } catch (err) {
      console.error('Failed to copy:', err);
    }
  }, []);

  const charCount = emailText.length;
  const isOverLimit = charCount > EMAIL_RESPONDER_CONFIG.MAX_EMAIL_LENGTH;

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 relative overflow-hidden">
      {/* Floating Email Logo Background */}
      <div className="absolute inset-0 opacity-[0.08] pointer-events-none overflow-hidden">
        {/* Email logo 1 - floating top right */}
        <div className="absolute animate-[float_15s_ease-in-out_infinite]" style={{ top: '10%', right: '15%' }}>
          <svg width="250" height="250" viewBox="0 0 300 300">
            {/* Email envelope shape made of dots */}
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`top-${i}`} cx={50 + i * 14} cy={50} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`bottom-${i}`} cx={50 + i * 14} cy={250} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`left-${i}`} cx={50} cy={50 + i * 14} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`right-${i}`} cx={250} cy={50 + i * 14} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 8 }).map((_, row) => (
              Array.from({ length: 8 - row }).map((_, col) => (
                <circle
                  key={`flap-${row}-${col}`}
                  cx={150 - (8 - row) * 6 + col * 12}
                  cy={50 + row * 12}
                  r="4"
                  fill="#007AFF"
                />
              ))
            ))}
            {Array.from({ length: 12 }).map((_, i) => (
              <circle key={`diag-left-${i}`} cx={50 + i * 8} cy={50 + i * 8} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 12 }).map((_, i) => (
              <circle key={`diag-right-${i}`} cx={250 - i * 8} cy={50 + i * 8} r="4" fill="#007AFF" />
            ))}
          </svg>
        </div>

        {/* Email logo 2 - floating bottom left */}
        <div className="absolute animate-[float_20s_ease-in-out_infinite_2s]" style={{ bottom: '15%', left: '10%' }}>
          <svg width="250" height="250" viewBox="0 0 300 300">
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`top-${i}`} cx={50 + i * 14} cy={50} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`bottom-${i}`} cx={50 + i * 14} cy={250} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`left-${i}`} cx={50} cy={50 + i * 14} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`right-${i}`} cx={250} cy={50 + i * 14} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 8 }).map((_, row) => (
              Array.from({ length: 8 - row }).map((_, col) => (
                <circle
                  key={`flap-${row}-${col}`}
                  cx={150 - (8 - row) * 6 + col * 12}
                  cy={50 + row * 12}
                  r="4"
                  fill="#007AFF"
                />
              ))
            ))}
            {Array.from({ length: 12 }).map((_, i) => (
              <circle key={`diag-left-${i}`} cx={50 + i * 8} cy={50 + i * 8} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 12 }).map((_, i) => (
              <circle key={`diag-right-${i}`} cx={250 - i * 8} cy={50 + i * 8} r="4" fill="#007AFF" />
            ))}
          </svg>
        </div>

        {/* Email logo 3 - floating center */}
        <div className="absolute animate-[float_18s_ease-in-out_infinite_4s]" style={{ top: '40%', left: '50%', transform: 'translateX(-50%)' }}>
          <svg width="250" height="250" viewBox="0 0 300 300">
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`top-${i}`} cx={50 + i * 14} cy={50} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`bottom-${i}`} cx={50 + i * 14} cy={250} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`left-${i}`} cx={50} cy={50 + i * 14} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 15 }).map((_, i) => (
              <circle key={`right-${i}`} cx={250} cy={50 + i * 14} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 8 }).map((_, row) => (
              Array.from({ length: 8 - row }).map((_, col) => (
                <circle
                  key={`flap-${row}-${col}`}
                  cx={150 - (8 - row) * 6 + col * 12}
                  cy={50 + row * 12}
                  r="4"
                  fill="#007AFF"
                />
              ))
            ))}
            {Array.from({ length: 12 }).map((_, i) => (
              <circle key={`diag-left-${i}`} cx={50 + i * 8} cy={50 + i * 8} r="4" fill="#007AFF" />
            ))}
            {Array.from({ length: 12 }).map((_, i) => (
              <circle key={`diag-right-${i}`} cx={250 - i * 8} cy={50 + i * 8} r="4" fill="#007AFF" />
            ))}
          </svg>
        </div>
      </div>

      <div className="relative z-10 container mx-auto px-4 py-8 max-w-7xl">
          {/* Tabs */}
          <div className="mb-6">
            <div className="flex gap-4 border-b border-gray-200">
              <button
                onClick={() => setActiveTab('compose')}
                className={`px-4 py-2 font-medium transition-colors ${
                  activeTab === 'compose'
                    ? 'text-blue-600 border-b-2 border-blue-600'
                    : 'text-gray-600 hover:text-gray-900'
                }`}
              >
                Compose & Classify
              </button>
              <button
                onClick={() => setActiveTab('history')}
                className={`px-4 py-2 font-medium transition-colors ${
                  activeTab === 'history'
                    ? 'text-blue-600 border-b-2 border-blue-600'
                    : 'text-gray-600 hover:text-gray-900'
                }`}
              >
                Email History Dashboard
              </button>
            </div>
          </div>

          {activeTab === 'history' ? (
            <EmailHistoryDashboard />
          ) : (
            <div className="max-w-4xl mx-auto">
        {/* Header */}
        <div className="text-center mb-12 pt-12">
          <h1 className="text-5xl font-semibold mb-3 text-gray-900">
            Email Response Generator
          </h1>
          <p className="text-lg text-gray-600">
            AI-powered property management assistant
          </p>
        </div>

        {/* Main content */}
        <div className="grid grid-cols-1 gap-6">
          {/* Input Card */}
          <GlassCard>
            <div className="space-y-6">
              {/* Email content input */}
              <FloatingLabel
                label="Email Content"
                value={emailText}
                onChange={setEmailText}
                placeholder="Paste the email content here..."
                multiline
                rows={12}
                maxLength={EMAIL_RESPONDER_CONFIG.MAX_EMAIL_LENGTH}
                showCharCount
                ariaLabel="Email content to analyze"
                disabled={loading}
              />

              {/* From and Subject */}
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <FloatingLabel
                  label="From Email"
                  value={fromEmail}
                  onChange={setFromEmail}
                  placeholder="sender@example.com"
                  type="email"
                  ariaLabel="Sender email address"
                  disabled={loading}
                />
                <FloatingLabel
                  label="Subject"
                  value={subject}
                  onChange={setSubject}
                  placeholder="Email subject"
                  ariaLabel="Email subject"
                  disabled={loading}
                />
              </div>

              {/* PALIMPZEST Toggle */}
              <div className="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-200">
                <div>
                  <div className="text-gray-900 font-medium">PALIMPZEST Optimization</div>
                  <div className="text-sm text-gray-600">95% cost savings, 3x faster</div>
                </div>
                <button
                  onClick={() => setUsePalimpzest(!usePalimpzest)}
                  className={`
                    relative inline-flex h-8 w-14 items-center rounded-full transition-colors duration-200
                    ${usePalimpzest ? 'bg-[#007AFF]' : 'bg-[#3A3A3C]'}
                  `}
                  disabled={loading}
                  aria-label="Toggle PALIMPZEST optimization"
                >
                  <span
                    className={`
                      inline-block h-6 w-6 transform rounded-full bg-white transition-transform duration-200
                      ${usePalimpzest ? 'translate-x-7' : 'translate-x-1'}
                    `}
                  />
                </button>
              </div>

              {/* Error display */}
              {error && (
                <div className="p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400">
                  <div className="flex items-center gap-2">
                    <svg className="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path fillRule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clipRule="evenodd" />
                    </svg>
                    <span>{error}</span>
                  </div>
                </div>
              )}

              {/* Submit Button */}
              <GradientButton
                onClick={handlePaste}
                disabled={isOverLimit}
                loading={loading}
                variant="primary"
                ariaLabel="Generate automated email response"
                ariaBusy={loading}
              >
                {isDebouncing && !loading ? 'Please wait...' : 'Generate Response'}
              </GradientButton>
            </div>
          </GlassCard>

          {/* Results Display */}
          {loading && !result && (
            <GlassCard>
              <div className="space-y-4">
                <div className="skeleton h-6 rounded w-1/3 mb-4" />
                <div className="skeleton h-4 rounded mb-2" />
                <div className="skeleton h-4 rounded w-5/6 mb-2" />
                <div className="skeleton h-4 rounded w-4/6" />
              </div>
            </GlassCard>
          )}

          {result && (
            <GlassCard>
              <div className="space-y-6">
                {/* Header */}
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="p-2 bg-[#34C759] rounded-lg">
                      <svg className="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <div>
                      <h2 className="text-2xl font-semibold text-gray-900">Generated Response</h2>
                      <p className="text-sm text-gray-600">Ready to send</p>
                    </div>
                  </div>
                </div>

                {/* Metrics */}
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div className="p-4 bg-gray-50 rounded-xl border border-gray-200">
                    <div className="text-sm text-gray-600 mb-1">Classification</div>
                    <div className="text-lg font-medium text-gray-900">{result.classification.template.name}</div>
                  </div>
                  <div className="p-4 bg-gray-50 rounded-xl border border-gray-200">
                    <div className="text-sm text-gray-600 mb-1">Confidence</div>
                    <div className="text-lg font-medium text-[#34C759]">{(result.classification.confidence * 100).toFixed(1)}%</div>
                  </div>
                  <div className="p-4 bg-gray-50 rounded-xl border border-gray-200">
                    <div className="text-sm text-gray-600 mb-1">Priority</div>
                    <div className="text-lg font-medium text-[#007AFF]">Level {result.classification.template.priority}</div>
                  </div>
                </div>

                {/* Response */}
                <div className="p-6 bg-gray-50 rounded-xl border border-gray-200">
                  <div className="space-y-4">
                    <div>
                      <div className="text-sm text-gray-600 mb-2">Subject</div>
                      <div className="text-gray-900 font-medium">{result.generatedResponse.subject}</div>
                    </div>
                    <div className="border-t border-gray-300 pt-4">
                      <div className="text-sm text-gray-600 mb-2">Body</div>
                      <div className="text-gray-900 whitespace-pre-wrap leading-relaxed">{result.generatedResponse.body}</div>
                    </div>
                  </div>
                </div>

                {/* Copy buttons */}
                <div className="flex gap-3">
                  <button
                    onClick={() => copyToClipboard(
                      `Subject: ${result.generatedResponse.subject}\n\n${result.generatedResponse.body}`,
                      'full'
                    )}
                    className="flex-1 px-4 py-3 bg-gray-100 hover:bg-gray-200 border border-gray-300 rounded-xl text-gray-900 font-medium transition-all duration-200"
                  >
                    {copySuccess === SUCCESS_MESSAGES.RESPONSE_COPIED ? '✓ Copied!' : 'Copy Full Response'}
                  </button>
                  <button
                    onClick={() => copyToClipboard(result.generatedResponse.body, 'body')}
                    className="flex-1 px-4 py-3 bg-gray-100 hover:bg-gray-200 border border-gray-300 rounded-xl text-gray-900 font-medium transition-all duration-200"
                  >
                    {copySuccess === SUCCESS_MESSAGES.BODY_COPIED ? '✓ Copied!' : 'Copy Body Only'}
                  </button>
                </div>
              </div>
            </GlassCard>
          )}
        </div>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
